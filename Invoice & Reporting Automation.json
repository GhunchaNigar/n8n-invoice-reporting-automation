    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const row = item.json;\n\n  const qty = Number(row['Quantity']);\n  const price = Number(row['Unit Price']);\n  const total = qty * price;\n\n  const now = new Date();\n  const due = new Date(now.getTime() + 14 * 24 * 60 * 60 * 1000);\n  const invoiceNo = `INV-${now.getFullYear()}-${String(row['ID']).padStart(4, '0')}`;\n  const money = (n) => '$' + n.toFixed(2);\n\n  const html = `\n<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto;border:1px solid #e5e5e5;border-radius:8px;padding:28px;color:#222\">\n  <h2 style=\"margin:0 0 4px;color:#ff6d5a\">INVOICE</h2>\n  <p style=\"margin:0 0 20px;color:#777\">${invoiceNo}</p>\n  <p style=\"margin:0\">Billed to: <strong>${row['Client Name']}</strong></p>\n  <p style=\"margin:0\">Issued: ${now.toDateString()}</p>\n  <p style=\"margin:0 0 20px\">Due: ${due.toDateString()}</p>\n  <table style=\"width:100%;border-collapse:collapse\">\n    <tr style=\"background:#f6f6f6;text-align:left\">\n      <th style=\"padding:8px\">Description</th>\n      <th style=\"padding:8px\">Qty</th>\n      <th style=\"padding:8px\">Unit price</th>\n      <th style=\"padding:8px;text-align:right\">Amount</th>\n    </tr>\n    <tr>\n      <td style=\"padding:8px;border-bottom:1px solid #eee\">${row['Description']}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee\">${qty}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee\">${money(price)}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;text-align:right\">${money(total)}</td>\n    </tr>\n  </table>\n  <h3 style=\"text-align:right;margin:18px 0 0\">Total due: ${money(total)}</h3>\n  <p style=\"color:#777;font-size:13px;margin-top:24px\">Thank you for your business.<br>Ghuncha Nigar, n8n Automation Specialist</p>\n</div>`;\n\n  return {\n    json: {\n      row_number: row.row_number,\n      ID: row['ID'],\n      invoiceNo,\n      clientName: row['Client Name'],\n      clientEmail: row['Client Email'],\n      amount: total,\n      sentAt: now.toISOString(),\n      subject: `Invoice ${invoiceNo} from Ghuncha Nigar`,\n      html\n    }\n  };\n});"
      },
